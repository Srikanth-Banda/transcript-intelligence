# Copy to .env and fill in. .env is git-ignored. Never commit a real key.
OPENROUTER_API_KEY=
# Pinned in DECISIONS.md D7: one model for every stage, provider pinned, no fallbacks
TI_MODEL_STAGE0=google/gemini-3.8-flash
TI_MODEL_STAGE1=google/gemini-3.8-flash
TI_MODEL_STAGE2=google/gemini-3.8-flash
# Comma-separated provider order to pin (no fallbacks). Empty = OpenRouter default routing.
TI_PROVIDER_ORDER=google-ai-studio
# live = call the API on cache miss; replay = cache only, a miss is an error
TI_MODE=live
# 0 = tracing hook is a no-op
TI_TRACING=0
